{
    "name": "opencat/segmentation",
    "description": "SRX-based sentence segmentation engine for the OpenCAT Framework",
    "type": "library",
    "version": "0.1.0",
    "require": {
        "php": "^8.2",
        "ext-mbstring": "*",
        "opencat/core": "^0.1",
        "opencat/srx": "^0.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "OpenCat\\Segmentation\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "OpenCat\\Segmentation\\Tests\\": "tests/"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../core"
        },
        {
            "type": "path",
            "url": "../srx"
        }
    ]
}
